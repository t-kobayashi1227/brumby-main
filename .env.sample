# 環境変数の見本。`cp .env.sample .env.local` で写し、値を入れて使う（npm run の各スクリプトは .env.local を読む）
# 実際の値は Notion に保存している。.env.local は git に入れない（.gitignore 済み）
# NEXT_PUBLIC_ の付いていないキーはサーバー側だけで使い、ブラウザ・ログ・画面に出さない
# 各変数の説明は README.md の「.env.local」

# --- DB（Supabase） ---
# Vercel では Transaction pooler（ポート 6543）の接続文字列にする
DATABASE_URL=postgresql://postgres.xxxxxxxx:パスワード@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres
# 動作確認（/api/health）で使う
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# すべてのデータを操作できるキー。サーバー側だけで使う
SUPABASE_SERVICE_ROLE_KEY=

# --- AI（エージェントの呼び出し） ---
# 提供元：anthropic（省略時）か openai
AI_PROVIDER=anthropic
# モデル（省略可。空なら提供元の既定）。使えるのは lib/agents/cost.ts の料金表にあるものだけ
#   anthropic の既定：HIGH claude-sonnet-5-5、LIGHT claude-haiku-5-5
#   openai の既定：HIGH gpt-6.1-sol、LIGHT gpt-6-luna
# 高性能の方（戦略担当と確認担当が使う）
AI_MODEL_HIGH=
# 軽い方（媒体担当が使う）
AI_MODEL_LIGHT=
# 使う提供元のキーだけあればよい
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- データの取り込み ---
# 不動産情報ライブラリAPI（取引価格の取り込み）。利用規約によりアクセスログを保存する
REINFOLIB_API_KEY=

# --- Basic認証（proxy.ts） ---
# 未設定だと認証なしで表示される（一時的に解除中）。本番では必ず設定する
BASIC_AUTH_PASSWORD=
# 省略時は brumby
BASIC_AUTH_USER=
